package-as: ForeverCore

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

ignore:
  - AGENTS.md
  - .agents
  - .claude
  - docs
  - tools
  - types
  - tests
  - media/icon.svg
  - media/icon-400.png
  - stylua.toml
  - ruff.toml
  # The tool pins and the Python tools' project: development files, never part of the addon.
  - toolchain.json
  - pyproject.toml
  - uv.lock
